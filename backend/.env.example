APP_NAME=OpsBrain AI Backend
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
POSTGRES_HOST_PORT=5433

DATABASE_URL=postgresql+asyncpg://opsbrain:opsbrain@localhost:5432/opsbrain
SYNC_DATABASE_URL=postgresql+psycopg://opsbrain:opsbrain@localhost:5432/opsbrain

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://opsbrain-ai.vercel.app

SERVICE_API_KEY=

EXTERNAL_REQUEST_TIMEOUT_SEC=15
MAX_WEBHOOK_PAYLOAD_BYTES=1048576

ZENDESK_WEBHOOK_SECRET=
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
ZENDESK_POSTBACK_ENABLED=false
