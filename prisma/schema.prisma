generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RunMode {
  FILE
  SYSTEM
}

enum RunStatus {
  INITIATED
  UPLOAD_COMPLETED
  IN_PROGRESS
  FETCHED_FROM_SUPPLIER
  VALIDATED
  BUFFER_IN_PROGRESS
  INSERTED_TO_BUFFER
  COMPLETED
  PARTIALLY_COMPLETED
  DISCARDED
  FAILED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueType {
  NOT_FOUND_IN_BAMBOO
  SUPPLIER_FETCH_FAILED
  ALREADY_PROCESSED
  EXPIRED
  INVALID_PRODUCT_BRAND
  INVALID_SUPPLIER
  DUPLICATE_CODE_OR_URL
  VALIDATION_ERROR
  AMBIGUOUS_MATCH
}

enum ActionType {
  APPROVE_MOVE_TO_BUFFER
  DISCARD_RUN
  RERUN_STAGE
  GENERATE_EVIDENCE_BUNDLE
  CREATE_JIRA_TICKET
  ADD_NOTE
}

enum ChatMessageRole {
  SYSTEM
  USER
  ASSISTANT
}

enum ChatMessageStatus {
  IDLE
  SENDING
  STREAMING
  DONE
  ERROR
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  accounts      Account[]
  sessions      Session[]
  chatConversations ChatConversation[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model ReconciliationRun {
  id               String    @id @default(cuid())
  processId        String    @unique
  mode             RunMode
  status           RunStatus
  entityType       String
  entityName       String
  currency         String
  dateFrom         DateTime
  dateTo           DateTime
  totalRecords     Int
  failedRecords    Int
  unmatchedRecords Int
  bufferedRecords  Int
  mismatchRate     Float
  estimatedExposure Int
  riskScore        Int
  severity         Severity
  uploadedByEmail  String?
  approvedByEmail  String?
  uploadedAt       DateTime
  approvedAt       DateTime?
  events           RunEvent[]
  issues           RunIssue[]
  actions          ActionLog[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, uploadedAt])
  @@index([entityName, uploadedAt])
  @@index([severity, uploadedAt])
  @@index([createdAt])
}

model RunEvent {
  id       String   @id @default(cuid())
  runId    String
  at       DateTime
  type     String
  message  String
  severity Severity
  metaJson Json?

  run ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, at])
}

model RunIssue {
  id                   String    @id @default(cuid())
  runId                String
  issueType            IssueType
  severity             Severity
  supplierIdentifier   String?
  supplierOrderNumber  String?
  cardId               String?
  orderId              String?
  productSku           String?
  brandName            String?
  errorMessage         String?
  createdAt            DateTime  @default(now())

  run ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, issueType])
  @@index([runId, severity])
  @@index([createdAt])
}

model ActionLog {
  id          String     @id @default(cuid())
  runId       String?
  actionType  ActionType
  actorEmail  String?
  note        String?
  payloadJson Json?
  createdAt   DateTime   @default(now())

  run ReconciliationRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([runId, createdAt])
  @@index([actionType, createdAt])
}

model ChatConversation {
  id         String        @id @default(cuid())
  userId     String
  title      String        @default("New chat")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  lastUsedAt DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   ChatMessage[]

  @@index([userId, lastUsedAt])
  @@index([createdAt])
}

model ChatMessage {
  id             String            @id @default(cuid())
  conversationId String
  role           ChatMessageRole
  content        String
  status         ChatMessageStatus @default(DONE)
  createdAt      DateTime          @default(now())
  conversation   ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([createdAt])
}
